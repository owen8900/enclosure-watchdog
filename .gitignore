# ============================================================
#  Cabinet Guardian · 控制柜健康监测与故障诊断系统
#  .gitignore
# ============================================================

# ---------- 编译产物 ----------
*.o
*.obj
*.elf
*.axf
*.hex
*.bin
*.map
*.lst
*.d
*.su
*.crf
*.dep
*.lnp
*.iex
*.sct
*.htm
*.build_log.htm
*.scvd
*.htm

# ---------- IDE / 工具链 ----------
.vscode/
.idea/
*.uvguix.*
*.uvoptx
*.uvprojx.user
*.launch
DebugConfig/
ReleaseConfig/
JLinkLog.txt
JLinkSettings.ini

# ---------- Python ----------
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# ---------- 临时文件 ----------
*.tmp
*.bak
*.orig
*.log
Thumbs.db
desktop.ini
~$*

# ---------- 工作笔记（采购、成本、比赛策略等，不公开） ----------
notes/

# ---------- 文档排版脚本（生成的 Word 不在仓库内，脚本也无须入库） ----------
/tools/

# ---------- 厂商参考资料（含版权，另存不分发） ----------
ref-vendor/
