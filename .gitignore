# ============================================================
#  Cabinet Guardian · 控制柜健康监测与故障诊断系统
#  .gitignore
# ============================================================

# ---------- 编译产物 ----------
*.o
*.obj
*.elf
*.axf
*.hex
*.bin
*.map
*.lst
*.d
*.su
*.crf
*.dep
*.lnp
*.iex
*.sct
*.htm
*.build_log.htm
*.scvd
*.htm

# ---------- IDE / 工具链 ----------
.vscode/
.idea/
*.uvguix.*
*.uvoptx
*.uvprojx.user
*.launch
DebugConfig/
ReleaseConfig/
JLinkLog.txt
JLinkSettings.ini

# ---------- Python ----------
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# ---------- 临时文件 ----------
*.tmp
*.bak
*.orig
*.log
Thumbs.db
desktop.ini
~$*

# ---------- 工作笔记（采购、成本、比赛策略等，不公开） ----------
notes/

# ---------- 文档排版脚本（生成的 Word 不在仓库内，脚本也无须入库） ----------
/tools/

# ---------- 厂商参考资料（含版权，另存不分发） ----------
ref-vendor/

# ============================================================
# STM32 固件工程（Keil MDK-ARM + STM32CubeMX）  2026-09-14
# ============================================================

# Keil 编译产物（89 个文件 / 76 MB，clone 后按 F7 可完全重新生成）
code/MDK-ARM/CabinetGuardian/

# Keil 个人界面布局（窗口位置等，换台电脑就没意义）
code/MDK-ARM/*.uvoptx
code/MDK-ARM/*.uvguix.*

# 手工备份文件
code/MDK-ARM/*.bak

# CubeMX 临时目录
code/MXTmpFiles/

# CubeMX 重新生成时的自动备份
*_save
*.ioc.bak

# Keil 5.43 从器件包拷进工程的调试配置（与 DebugConfig/ 里那份同内容，
# 删掉会自动重建，不必入库）
code/MDK-ARM/RTE/Device/
